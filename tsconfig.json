{
	"compilerOptions": {
		"esModuleInterop": true,
		"isolatedModules": true,
		"module": "preserve",
		"moduleResolution": "bundler",
		"noEmit": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedParameters": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ESNext",
		"verbatimModuleSyntax": true
	},
	"include": ["src/**/*", "*.ts", "*.mts"]
}
